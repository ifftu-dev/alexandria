# ── OS ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
._*

# ── Editors / IDEs ────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*~

# ── Node.js ───────────────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local
.vite/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Rust / Cargo ──────────────────────────────────────────────────────
target/
# The workspace root Cargo.lock IS tracked (required for applications).
# src-tauri/Cargo.lock is NOT tracked — workspace members share the root lockfile.
src-tauri/Cargo.lock

# ── Tauri ─────────────────────────────────────────────────────────────
# Generated IPC schema files (rebuilt on every dev/build)
src-tauri/gen/schemas/

# ── Android (Tauri gen) ──────────────────────────────────────────────
# Build outputs and caches (the gen/android/ scaffold itself IS tracked)
src-tauri/gen/android/.gradle/
src-tauri/gen/android/.idea/
src-tauri/gen/android/.cxx/
src-tauri/gen/android/captures/
src-tauri/gen/android/build/
src-tauri/gen/android/app/build/
src-tauri/gen/android/buildSrc/.gradle/
src-tauri/gen/android/buildSrc/build/
src-tauri/gen/android/local.properties
# Tauri-generated files (rebuilt per build)
src-tauri/gen/android/app/src/main/assets/
src-tauri/gen/android/app/src/main/java/org/alexandria/node/generated/
src-tauri/gen/android/app/src/main/jniLibs/
src-tauri/gen/android/app/tauri.build.gradle.kts
src-tauri/gen/android/app/tauri.properties
src-tauri/gen/android/app/proguard-tauri.pro
src-tauri/gen/android/tauri.settings.gradle
src-tauri/gen/android/.tauri/

# ── iOS / Xcode (Tauri gen) ──────────────────────────────────────────
# Build outputs and caches (the gen/apple/ scaffold itself IS tracked)
src-tauri/gen/apple/build/
src-tauri/gen/apple/.build/
src-tauri/gen/apple/Externals/
src-tauri/gen/apple/Pods/
src-tauri/gen/apple/**/DerivedData/
xcuserdata/
*.xcuserstate

# ── Java / jenv ──────────────────────────────────────────────────────
.java-version

# ── Environment / secrets ─────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
credentials.json
# but NOT the i18n "credentials" namespace catalogs (UI strings, not secrets)
!src/locales/*/credentials.json
key.properties

# ── Local dev data (legacy CLI seed tool output) ─────────────────────
dev-data/

# ── Operational env files (Blockfrost credentials, deployer key paths) ─
scripts/env.completion
!scripts/env.completion.example

# ── Misc ──────────────────────────────────────────────────────────────
*.tgz
*.tsbuildinfo
cardano/governance/build/

# Cardano signing keys (treasury etc.) — never commit
keys/
.claude/

# CLI sidecar staged by scripts/build-cli-sidecar.sh for the release bundle.
# Built artifact, never committed.
src-tauri/binaries/
src-tauri/macos-frameworks/

# Built by scripts/demo/ax.sh from axtool.swift on first run.
scripts/demo/axtool

# python bytecode from cardano/governance/deploy_*.py
__pycache__/

# Vendored mobile-push plugin: native build outputs (the sources ARE tracked)
crates/tauri-plugin-mobile-push/.tauri/
crates/tauri-plugin-mobile-push/ios/.build/
crates/tauri-plugin-mobile-push/ios/.swiftpm/
crates/tauri-plugin-mobile-push/ios/.tauri/
crates/tauri-plugin-mobile-push/ios/Package.resolved
crates/tauri-plugin-mobile-push/android/build/
crates/tauri-plugin-mobile-push/android/.gradle/
crates/tauri-plugin-mobile-push/android/.tauri/

# Firebase project file for Android push: per-developer, never committed.
src-tauri/gen/android/app/google-services.json

# Firebase configuration for push on iOS, downloaded per project from the
# Firebase console; the Android counterpart is the google-services.json above.
src-tauri/gen/apple/alexandria-node_iOS/GoogleService-Info.plist
playwright-report/
test-results/

# Tauri copies this API from the locked tauri dependency during iOS builds.
patches/tauri-plugin-notification/.tauri/
patches/tauri-plugin-notification/ios/.build/
patches/tauri-plugin-notification/ios/.swiftpm/
patches/tauri-plugin-notification/ios/Package.resolved
src-tauri/gen/android/buildSrc/.kotlin/
