<?xml version="1.0" encoding="utf-8"?>
<!-- Release: no cleartext anywhere except the loopback address, where a cmi5
     unit's per-session endpoint listens (http://127.0.0.1:<port>, see
     packages::attempts::cmi5). The literal address only, no subdomains.
     Debug builds replace this file (app/src/debug/res/xml) to reach the
     development server as well. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
