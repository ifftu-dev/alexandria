{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      // Default typecheck targets the MIT community stub — the build that
      // must always compile. `tsconfig.ee.json` repoints this at `src/ee`
      // to typecheck the enterprise build. Both implement the shared
      // `EntitlementProvider` contract, so drift between them is a type
      // error rather than a runtime surprise.
      "@ee/*": ["src/ee-stub/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"]
}
